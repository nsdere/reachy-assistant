ANTHROPIC_API_KEY=sk-ant-replace-me
OPENAI_API_KEY=sk-replace-me

CLOUD_MODEL=claude-haiku-4-5
LOCAL_MODEL=qwen3:1.7b
EMBED_MODEL=nomic-embed-text

# Ceiling across "Hey Mando" and "Mando live" together. At $0.05/min for a live
# session this is ~20 minutes of chat a day. Raise it only once you have seen a
# real bill.
DAILY_BUDGET_USD=1.00

# "Mando live". Confirm LIVE_URL against the current GPT-Live reference before
# the first billed run - it is the one value in app/live.py worth re-checking.
LIVE_URL=wss://api.openai.com/v1/live/sessions
LIVE_MODEL=gpt-live-1
LIVE_VOICE=marin
LIVE_DELEGATE_MODEL=gpt-5.6-terra
# Seconds of silence before a live session closes itself. This is what stops a
# forgotten session from billing overnight.
LIVE_IDLE_SECONDS=25

# Speech. Whisper auto-detects language when WHISPER_LANGUAGE is empty; pin it
# ("en", "tr") if you always speak one. Piper has Turkish: tr_TR-dfki-medium
WHISPER_MODEL=base
WHISPER_LANGUAGE=
PIPER_VOICE=en_US-lessac-medium
