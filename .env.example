# Copy to .env on the Proxmox box and fill in. Never commit .env.

# --- Cloud (general, non-personal questions only) ---
# Used from Phase 4 onward. No personal data is ever sent here.
OPENAI_API_KEY=

# --- Local services (defaults match docker-compose.yml) ---
QDRANT_URL=http://localhost:6333
WHISPER_URL=http://localhost:8000
PIPER_HOST=localhost
PIPER_PORT=10200

# --- Ollama (already installed on the box, not managed by this compose) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_ANSWER_MODEL=qwen2.5:7b
OLLAMA_CLASSIFIER_MODEL=qwen2.5:3b

# --- STT ---
WHISPER_MODEL=Systran/faster-whisper-small

# --- Ingestion source paths (on the Proxmox box) ---
NOTES_DIR=/data/sources/notes
WHATSAPP_DROP_DIR=/data/sources/whatsapp
